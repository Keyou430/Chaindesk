{
  "version": "2.5.9",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": false,
    "longDescription": "ChainDesk portable proxy client based on Clash Verge Rev",
    "icon": [
      "icons/chaindesk/32x32.png",
      "icons/chaindesk/128x128.png",
      "icons/chaindesk/128x128@2x.png",
      "icons/chaindesk/icon.ico"
    ],
    "resources": ["resources"],
    "publisher": "ChainDesk",
    "externalBin": ["sidecar/verge-mihomo", "sidecar/verge-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "ChainDesk portable proxy client",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "ChainDesk",
  "identifier": "local.chaindesk.portable",
  "plugins": {},
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
